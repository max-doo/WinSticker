<UserControl x:Class="WinSticker.Controls.QuickPanelNotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinSticker.Controls"
    xmlns:models="using:WinSticker.Models"
    xmlns:svc="using:WinSticker.Services"
    xmlns:helpers="using:WinSticker.Helpers">
    <Grid RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListView x:Name="NoteTabs" Height="36" ItemsSource="{Binding Notes}"
                      SelectionMode="Single" SelectionChanged="NoteTabs_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="30"/>
                        <Setter Property="BorderThickness" Value="1"/>

                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QuickPanelNoteItem">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" MaxWidth="110" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" helpers:WidgetTextShadow.Cast="True"/>
                            <Button Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="4" Style="{StaticResource SubtleButtonStyle}" Click="CloseNoteButton_Click" svc:Localized.AutomationNameKey="Common.Close" svc:Localized.ToolTipKey="Common.Close">
                                <FontIcon FontSize="10" Glyph="&#xE8BB;"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="AddNoteButton" Grid.Column="1" Width="30" Height="32" Padding="6" Style="{StaticResource SubtleButtonStyle}" Click="AddNoteButton_Click"><FontIcon FontSize="14" Glyph="&#xE710;"/></Button>
            <Button x:Name="LibraryButton" Grid.Column="2" Width="30" Height="32" Padding="6" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE8FD;"/>
                <Button.Flyout>
                    <Flyout x:Name="ClosedNotesFlyout">
                        <ListView ItemsSource="{Binding AllNotes}" MaxHeight="300" Width="270" IsItemClickEnabled="True" ItemClick="Library_ItemClick" SelectionMode="None">
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:QuickPanelNoteItem">
                                <Grid Padding="4,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" helpers:WidgetTextShadow.Cast="True"/>
                                    <Button Grid.Column="1" Style="{StaticResource WidgetItemActionButtonStyle}" VerticalAlignment="Center" Click="LibraryDeleteButton_Click" svc:Localized.AutomationNameKey="Common.Delete" svc:Localized.ToolTipKey="Common.Delete">
                                        <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE74D;"/>
                                    </Button>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <controls:NoteEditorPane x:Name="NotePane" Grid.Row="1"/>
    </Grid>
</UserControl>
