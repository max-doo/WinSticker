<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinSticker.Controls.QuickPanelClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:WinSticker.Helpers"
    xmlns:models="using:WinSticker.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:QuickPanelCountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:QuickPanelZeroCountToVisibilityConverter x:Key="ZeroCountToVis"/>
        <helpers:QuickPanelClipboardDisplayTextConverter x:Key="ClipboardDisplayText"/>
        <helpers:QuickPanelStarGlyphConverter x:Key="StarGlyph"/>
        <helpers:QuickPanelStarForegroundConverter x:Key="StarForeground"/>
        <helpers:QuickPanelItemIsImageConverter x:Key="ItemIsImage"/>
        <helpers:QuickPanelItemIsNotImageConverter x:Key="ItemIsNotImage"/>
        <helpers:QuickPanelImageSourceConverter x:Key="ImageSourceConverter"/>
    </UserControl.Resources>

    <!-- Mirrors the Windows clipboard history (Win+V): bare content cards
         with hover-revealed action buttons, plus filter tabs, an on-demand
         search entry, and a header clear-all. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: category filters + search entry + clear all -->
        <Grid Grid.Row="0" Margin="0,0,0,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <toolkit:Segmented
                x:Name="FilterSegmented"
                HorizontalAlignment="Left"
                SelectedIndex="0"
                SelectionChanged="FilterSegmented_SelectionChanged">
                <toolkit:SegmentedItem Content="全部" Tag="All"/>
                <toolkit:SegmentedItem Content="文本" Tag="Text"/>
                <toolkit:SegmentedItem Content="图片" Tag="Image"/>
                <toolkit:SegmentedItem Content="收藏" Tag="Favorites"/>
            </toolkit:Segmented>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="SearchToggleButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="搜索"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SearchToggleButton_Click"
                    ToolTipService.ToolTip="搜索">
                    <FontIcon FontSize="14" Glyph="&#xE721;"/>
                </Button>

                <!-- Clear all (unpinned), like Windows clipboard history -->
                <Button
                    x:Name="ClearAllButton"
                    Padding="8,4"
                    AutomationProperties.Name="全部清除"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding FilteredClipboardItems.Count, Converter={StaticResource CountToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE74D;"/>
                        <TextBlock Text="全部清除"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ClearAllFlyout" Placement="Bottom">
                            <StackPanel Width="240" Spacing="12">
                                <TextBlock
                                    FontSize="13"
                                    Text="将清除全部未固定的剪贴板记录"
                                    TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="ClearAllCancel_Click"
                                        Content="取消"/>
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Click="ClearAllConfirm_Click"
                                        Content="全部清除"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search entry: expands on demand, Esc or toggle collapses it and
             clears the live filter so it never stays applied invisibly. -->
        <TextBox
            x:Name="ClipboardSearchBox"
            Grid.Row="1"
            Margin="0,0,0,6"
            PlaceholderText="搜索剪贴板历史..."
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="Collapsed"
            KeyDown="ClipboardSearchBox_KeyDown">
            <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            </TextBox.Resources>
        </TextBox>

        <!-- Clipboard History List -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="HistoryListView"
                ItemsSource="{Binding FilteredClipboardItems}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="HistoryListView_ItemClick"
                DoubleTapped="HistoryListView_DoubleTapped"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QuickCaptureItem">
                        <Border
                            x:Name="ItemRoot"
                            Margin="0,3"
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            PointerEntered="ItemRoot_PointerEntered"
                            PointerExited="ItemRoot_PointerExited">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="复制" Click="FlyoutCopy_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="粘贴到目标窗口" Click="FlyoutPaste_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="收藏 / 取消收藏" Click="FlyoutFavorite_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE735;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="保存为便签" Click="FlyoutSaveAsNote_Click" IsEnabled="{Binding IsRecent}" Visibility="{Binding Converter={StaticResource ItemIsNotImage}}"/>
                                    <MenuFlyoutItem Text="删除" Click="FlyoutDelete_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>

                            <Grid>
                                <Border
                                    x:Name="ClipboardItemHoverBackground"
                                    Margin="-12,-10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>

                                <!-- Windows clipboard cards show bare content:
                                     wrapped text, or the image preview itself. -->
                                <TextBlock
                                    helpers:WidgetTextShadow.Cast="False"
                                    FontSize="13"
                                    MaxLines="5"
                                    Text="{Binding Converter={StaticResource ClipboardDisplayText}}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Converter={StaticResource ItemIsNotImage}}"/>

                                <Image
                                    MaxHeight="150"
                                    HorizontalAlignment="Center"
                                    Source="{Binding Converter={StaticResource ImageSourceConverter}}"
                                    Stretch="Uniform"
                                    Visibility="{Binding Converter={StaticResource ItemIsImage}}"/>

                                <Border
                                    x:Name="ClipboardItemActionHost"
                                    Margin="0,-2,-6,-2"
                                    Padding="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource WidgetOverlaySurfaceBrush}"
                                    Canvas.ZIndex="2"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button
                                            Width="26"
                                            Height="26"
                                            MinWidth="26"
                                            MinHeight="26"
                                            AutomationProperties.Name="收藏"
                                            Click="FavoriteButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            ToolTipService.ToolTip="收藏">
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{Binding IsPinned, Converter={StaticResource StarForeground}}"
                                                Glyph="{Binding IsPinned, Converter={StaticResource StarGlyph}}"/>
                                        </Button>
                                        <Button
                                            Width="26"
                                            Height="26"
                                            MinWidth="26"
                                            MinHeight="26"
                                            AutomationProperties.Name="复制"
                                            Click="CopyButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            ToolTipService.ToolTip="复制">
                                            <FontIcon FontSize="13" Glyph="&#xE8C8;"/>
                                        </Button>
                                        <Button
                                            Width="26"
                                            Height="26"
                                            MinWidth="26"
                                            MinHeight="26"
                                            AutomationProperties.Name="删除"
                                            Click="DeleteButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            ToolTipService.ToolTip="删除">
                                            <FontIcon FontSize="13" Glyph="&#xE74D;"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding FilteredClipboardItems.Count, Converter={StaticResource ZeroCountToVis}}">
                <FontIcon FontSize="36" Glyph="&#xE8C8;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock
                    Text="暂无剪贴板历史"
                    FontSize="14"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    Text="复制文本、图片或链接后将自动记录在此"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
