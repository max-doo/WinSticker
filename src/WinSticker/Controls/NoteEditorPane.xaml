<UserControl
    x:Class="WinSticker.Controls.NoteEditorPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinSticker.Controls"
    AllowDrop="True" DragOver="Pane_DragOver" Drop="Pane_Drop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NotePaperBrush" Color="#FFFAF5EA"/>
                    <SolidColorBrush x:Key="NoteYellowBrush" Color="#FFFFF0B3"/>
                    <SolidColorBrush x:Key="NoteRoseBrush" Color="#FFFCE3EA"/>
                    <SolidColorBrush x:Key="NoteMintBrush" Color="#FFDDF3E3"/>
                    <SolidColorBrush x:Key="NoteBlueBrush" Color="#FFDFECF8"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NotePaperBrush" Color="#FF3A3630"/>
                    <SolidColorBrush x:Key="NoteYellowBrush" Color="#FF4A4025"/>
                    <SolidColorBrush x:Key="NoteRoseBrush" Color="#FF472E38"/>
                    <SolidColorBrush x:Key="NoteMintBrush" Color="#FF284235"/>
                    <SolidColorBrush x:Key="NoteBlueBrush" Color="#FF2B3D53"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="NoteSurface" Padding="10,8" CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PaperStates">
                    <VisualState x:Name="Default"><VisualState.Setters><Setter Target="NoteSurface.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Paper"><VisualState.Setters><Setter Target="NoteSurface.Background" Value="{ThemeResource NotePaperBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="StickyYellow"><VisualState.Setters><Setter Target="NoteSurface.Background" Value="{ThemeResource NoteYellowBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Rose"><VisualState.Setters><Setter Target="NoteSurface.Background" Value="{ThemeResource NoteRoseBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Mint"><VisualState.Setters><Setter Target="NoteSurface.Background" Value="{ThemeResource NoteMintBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="MistBlue"><VisualState.Setters><Setter Target="NoteSurface.Background" Value="{ThemeResource NoteBlueBrush}"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        <Grid RowSpacing="6">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TitleEditor" FontSize="16" FontWeight="SemiBold" MinWidth="0"
                         Background="Transparent" BorderThickness="0" Padding="4,4"
                         TextChanged="TitleEditor_TextChanged"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="FavoriteButton" Width="30" Height="30" Padding="6" Style="{StaticResource SubtleButtonStyle}" Click="FavoriteButton_Click">
                        <controls:PinStateIcon x:Name="FavoriteIcon" Width="14" Height="14" IsFavoriteStyle="True" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="ColorButton" Width="30" Height="30" Padding="6" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE790;"/>
                        <Button.Flyout><Flyout><StackPanel x:Name="ColorPalette" Orientation="Horizontal" Spacing="4"/></Flyout></Button.Flyout>
                    </Button>
                    <Button x:Name="MoreButton" Width="30" Height="30" Padding="6" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE712;"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="ExtractTasksItem" Click="ExtractTasksItem_Click"/>
                                <ToggleMenuFlyoutItem x:Name="MarkdownItem" Click="MarkdownItem_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="DeleteItem" Click="DeleteItem_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <controls:MarkdownSourceEditor x:Name="Editor" Grid.Row="1" MinHeight="72" EnableCtrlSSaveShortcut="True"/>
            <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:AttachmentTileStrip x:Name="AttachmentsStrip" CanRemove="True" OpenRequested="AttachmentsStrip_OpenRequested" RemoveRequested="AttachmentsStrip_RemoveRequested"/>
                <Button x:Name="AddAttachmentButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Padding="6,4" VerticalAlignment="Center" Click="AddAttachmentButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE723;"/>
                </Button>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="RetryButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Click="RetryButton_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="UpdatedTime" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <InfoBar x:Name="ActionNotice" Grid.Row="4" IsOpen="False" Severity="Success">
                <InfoBar.ActionButton><Button x:Name="UndoDeleteButton" Click="UndoDeleteButton_Click"/></InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Border>
</UserControl>
