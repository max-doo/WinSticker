<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinSticker.Controls.WidgetContents.TodoCalendarContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WinSticker.Controls"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    SizeChanged="TodoCalendarContent_SizeChanged"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="8,4,8,8">
        <Grid.RowDefinitions>
            <!-- Navigation header -->
            <RowDefinition Height="Auto" />
            <!-- Weekday headers -->
            <RowDefinition Height="Auto" />
            <!-- 42-day Month Grid -->
            <RowDefinition Height="*" MinHeight="180" />
            <!-- Selected Day Tasks Section -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,2,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevMonthButton" Click="PrevMonthButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="4" Height="28" Width="28" CornerRadius="4">
                    <FontIcon Glyph="&#xE76B;" FontSize="11" />
                </Button>
                <TextBlock x:Name="MonthTitleText" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" Margin="8,0" />
                <Button x:Name="NextMonthButton" Click="NextMonthButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="4" Height="28" Width="28" CornerRadius="4">
                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <Button x:Name="TodayButton" Click="TodayButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,3" Height="28" CornerRadius="4">
                    <TextBlock x:Name="TodayButtonText" Text="今天" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Weekday header -->
        <Grid x:Name="WeekdayHeaderGrid" Grid.Row="1" Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- 42-cell Month Grid -->
        <Grid x:Name="MonthGrid" Grid.Row="2"
              PointerWheelChanged="MonthGrid_PointerWheelChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- Selected Day Tasks Section -->
        <Border x:Name="SelectedDaySection" Grid.Row="3"
                Margin="0,6,0,0" Padding="6,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                MaxHeight="120" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SelectedDayTasksList" Spacing="4" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
