<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinSticker.Controls.WidgetContents.GlanceWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:WinSticker.Helpers"
    xmlns:local="using:WinSticker.Controls.WidgetContents"
    xmlns:vm="using:WinSticker.ViewModels"
    Background="Transparent"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <local:GlanceBoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:GlanceStringNonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <local:GlanceDaytimeToOpacityConverter x:Key="DaytimeToOpacity" />
        <DataTemplate x:Key="WorldClockRowTemplate" x:DataType="vm:GlanceWorldClockRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Opacity="0.9">
                    <TextBlock
                        helpers:WidgetTextShadow.Cast="True"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind CityName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        helpers:WidgetTextShadow.Cast="True"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind RelativeDayText}"
                        Visibility="{x:Bind RelativeDayText, Converter={StaticResource NonEmptyToVisibility}}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    helpers:WidgetTextShadow.Cast="True"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Opacity="{x:Bind IsDaytime, Converter={StaticResource DaytimeToOpacity}}"
                    Text="{x:Bind TimeText}"
                    Typography.NumeralAlignment="Tabular" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Contrast plate: only the transparent surface shows it, and only
             when the sampled wallpaper cannot carry the text on its own (see
             DesktopWallpaperContrastProbe). It bleeds past the text bounds so
             the plate never crops the numerals. -->
        <Border
            x:Name="ContrastPlate"
            Margin="2"
            CornerRadius="12"
            IsHitTestVisible="False"
            Visibility="{Binding ShowContrastPlate, Converter={StaticResource BoolToVisibility}}" />
        <Grid
            x:Name="ContentHost"
            Padding="14,8,14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsForegroundVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: main clock, date, world clocks -->
                <StackPanel x:Name="ClockColumn" Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TimeTextBlock"
                        FontFamily="{Binding TimeFontFamily}"
                        FontSize="{Binding TimeFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="False"
                        Text="{Binding TimeText}"
                        Typography.NumeralAlignment="Tabular"
                        Visibility="{Binding ShowTime, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            FontSize="{Binding DateFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding DateText}"
                            Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            FontSize="{Binding DateFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding WeekdayText}"
                            Visibility="{Binding ShowWeekday, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ItemsControl
                        Margin="0,4,0,0"
                        ItemTemplate="{StaticResource WorldClockRowTemplate}"
                        ItemsSource="{Binding WorldClockRows}"
                        Visibility="{Binding HasWorldClocks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: modern spacious weather block -->
                <StackPanel
                    x:Name="WeatherColumn"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3"
                    Visibility="{Binding ShowWeatherBlock, Converter={StaticResource BoolToVisibility}}">
                    <!-- Row 1: Weather icon + Temperature + Weather description -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Image
                            Width="{Binding WeatherIconSize}"
                            Height="{Binding WeatherIconSize}"
                            VerticalAlignment="Center"
                            Source="{Binding WeatherIcon}" />
                        <TextBlock
                            FontSize="{Binding WeatherTempFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding WeatherTemperatureText}"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontSize="{Binding WeatherSubFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding WeatherDescription}"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Row 2: Range (e.g. 23°~31°) + Location name (e.g. 广州) -->
                    <StackPanel
                        Margin="2,0,0,0"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{Binding WeatherSubFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{Binding WeatherRangeText}"
                            Typography.NumeralAlignment="Tabular"
                            Visibility="{Binding HasWeatherRange, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            FontSize="{Binding WeatherSubFontSize}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            MaxLines="1"
                            Text="{Binding WeatherLocationName}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding WeatherLocationName, Converter={StaticResource NonEmptyToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
