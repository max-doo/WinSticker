<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinSticker.Views.SettingsSections.GlanceWidgetSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WinSticker.Services"
    xmlns:local="using:WinSticker.Views.SettingsSections"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:WinSticker.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <StackPanel Spacing="4">
            <toolkit:SettingsCard
                x:Name="InstanceManagerCard"
                HorizontalContentAlignment="Stretch"
                svc:Localized.HeaderKey="Glance.Instances.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE787;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox svc:Localized.AutomationNameKey="Glance.Instances.Title"
                        x:Name="InstanceComboBox"
                        MinWidth="210"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="InstanceComboBox_SelectionChanged" />
                    <ToggleSwitch svc:Localized.AutomationNameKey="Glance.Instances.Title"
                        x:Name="InstanceEnabledToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="InstanceEnabledToggle_Toggled"
                        svc:Localized.ToolTipKey="Glance.Instances.Enable" />
                    <Button svc:Localized.AutomationNameKey="Glance.Instances.Add"
                        x:Name="AddInstanceButton"
                        Grid.Column="2"
                        Click="AddInstanceButton_Click"
                        Style="{StaticResource IconActionButtonStyle}"
                        svc:Localized.ToolTipKey="Glance.Instances.Add">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                    <Button svc:Localized.AutomationNameKey="Glance.Instances.More"
                        x:Name="InstanceMoreButton"
                        Grid.Column="3"
                        Style="{StaticResource IconActionButtonStyle}"
                        svc:Localized.ToolTipKey="Glance.Instances.More">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="LocateInstanceMenuItem" Click="LocateInstanceMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE707;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DuplicateInstanceMenuItem" Click="DuplicateInstanceMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="RenameInstanceMenuItem" Click="RenameInstanceMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="DeleteInstanceMenuItem" Click="DeleteInstanceMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </toolkit:SettingsCard>

            <StackPanel x:Name="InstanceSettingsPanel" Spacing="4">
            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Glance.Size.Description"
                svc:Localized.HeaderKey="Glance.Size.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B2;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="SizeScaleValue"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingValueTextStyle}" />
                    <Slider svc:Localized.AutomationNameKey="Glance.Size.Title"
                        x:Name="SizeScaleSlider"
                        Width="190"
                        Minimum="0.75"
                        Maximum="1.75"
                        StepFrequency="0.05"
                        ValueChanged="SizeScaleSlider_ValueChanged" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander
                IsExpanded="False"
                svc:Localized.HeaderKey="Glance.Typography.Font">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8D2;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Glance.Typography.Font"
                    x:Name="FontComboBox"
                    Width="220"
                    MaxDropDownHeight="360"
                    SelectionChanged="FontComboBox_SelectionChanged" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Glance.TimeFormat.Description"
                        svc:Localized.HeaderKey="Glance.Typography.TimeFormat">
                        <ComboBox svc:Localized.AutomationNameKey="Glance.Typography.TimeFormat"
                            x:Name="TimeFormatComboBox"
                            Width="220"
                            MaxDropDownHeight="320"
                            SelectionChanged="TimeFormatComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.HeaderKey="Glance.Display.Seconds">
                        <ToggleSwitch svc:Localized.AutomationNameKey="Glance.Display.Seconds"
                            x:Name="ShowSecondsToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ShowSecondsToggle_Toggled" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.HeaderKey="Glance.Typography.Title">
                        <Slider svc:Localized.AutomationNameKey="Glance.Typography.Title"
                            x:Name="TimeScaleSlider"
                            Width="190"
                            IsThumbToolTipEnabled="False"
                            Minimum="0.75"
                            Maximum="1.35"
                            StepFrequency="0.05"
                            ValueChanged="TimeScaleSlider_ValueChanged" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Glance.Display.Description"
                svc:Localized.HeaderKey="Glance.Display.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE890;" />
                </toolkit:SettingsCard.HeaderIcon>
                <DropDownButton
                    x:Name="DisplayContentDropDownButton"
                    Width="220"
                    HorizontalAlignment="Right"
                    Click="DisplayContentDropDown_Click" />
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander
                IsExpanded="False"
                svc:Localized.DescriptionKey="Glance.WorldClock.Description"
                svc:Localized.HeaderKey="Glance.WorldClock.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8C8;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="WorldClockCountText"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingDescriptionTextStyle}" />
                </StackPanel>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"
                        svc:Localized.HeaderKey="Glance.WorldClock.List">
                        <StackPanel Spacing="4">
                            <ItemsControl x:Name="WorldClockList" ItemsSource="{x:Bind WorldClockRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GlanceWorldClockRow">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                MaxLines="1"
                                                Text="{x:Bind SettingsDisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Click="RemoveWorldClockButton_Click"
                                                Style="{StaticResource IconActionButtonStyle}"
                                                svc:Localized.AutomationNameKey="Glance.WorldClock.Remove"
                                                svc:Localized.ToolTipKey="Glance.WorldClock.Remove"
                                                Tag="{x:Bind TimeZoneId}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="WorldClockNameBox"
                                    MaxLength="24"
                                    PlaceholderText="" />
                                <ComboBox
                                    x:Name="WorldClockZoneComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    MaxDropDownHeight="320"
                                    PlaceholderText="" />
                                <Button svc:Localized.AutomationNameKey="Glance.WorldClock.Add"
                                    x:Name="AddWorldClockButton"
                                    Grid.Column="2"
                                    Click="AddWorldClockButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    svc:Localized.Key="Glance.WorldClock.Add" />
                            </Grid>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                IsExpanded="False"
                svc:Localized.DescriptionKey="Glance.SurfaceGroup.Description"
                svc:Localized.HeaderKey="Glance.SurfaceGroup.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Glance.Surface.Title"
                    x:Name="SurfaceMaterialComboBox"
                    Width="220"
                    MaxDropDownHeight="240"
                    SelectionChanged="SurfaceMaterialComboBox_SelectionChanged" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        x:Name="SurfaceOpacityCard"
                        HorizontalContentAlignment="Right"
                        Visibility="Collapsed"
                        svc:Localized.DescriptionKey="Glance.Surface.TransparencyDescription"
                        svc:Localized.HeaderKey="Glance.Surface.Transparency">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="SurfaceOpacityValue"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingValueTextStyle}" />
                            <Slider svc:Localized.AutomationNameKey="Glance.Surface.Transparency"
                                x:Name="SurfaceOpacitySlider"
                                Width="190"
                                Minimum="0.05"
                                Maximum="1"
                                StepFrequency="0.01"
                                ValueChanged="SurfaceOpacitySlider_ValueChanged" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Glance.Contrast.Description"
                        svc:Localized.HeaderKey="Glance.Contrast.Title">
                        <ComboBox svc:Localized.AutomationNameKey="Glance.Contrast.Title"
                            x:Name="TextContrastComboBox"
                            Width="220"
                            SelectionChanged="TextContrastComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Glance.Contrast.PlateDescription"
                        svc:Localized.HeaderKey="Glance.Contrast.Plate">
                        <ToggleSwitch svc:Localized.AutomationNameKey="Glance.Contrast.Plate"
                            x:Name="TextPlateToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="TextPlateToggle_Toggled" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
