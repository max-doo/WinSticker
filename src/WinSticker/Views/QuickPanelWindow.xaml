<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinSticker.Views.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinSticker.Controls"
    xmlns:helpers="using:WinSticker.Helpers"
    xmlns:svc="using:WinSticker.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          PreviewKeyDown="RootGrid_PreviewKeyDown">

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <!-- Layer on Acrylic card standard for Quick Panel flyout -->
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#E6FFFFFF" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#18000000" />
                        <SolidColorBrush x:Key="WidgetLayerFillSecondaryBrush" Color="#E6FFFFFF" />
                        <SolidColorBrush x:Key="WidgetLayerStrokeBrush" Color="#18000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <!-- Layer on Acrylic card standard for Quick Panel flyout -->
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#D926292E" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2EFFFFFF" />
                        <SolidColorBrush x:Key="WidgetLayerFillSecondaryBrush" Color="#D926292E" />
                        <SolidColorBrush x:Key="WidgetLayerStrokeBrush" Color="#2EFFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#D926292E" />
                        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2EFFFFFF" />
                        <SolidColorBrush x:Key="WidgetLayerFillSecondaryBrush" Color="#D926292E" />
                        <SolidColorBrush x:Key="WidgetLayerStrokeBrush" Color="#2EFFFFFF" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Storyboard x:Name="PopupShowStoryboard">
                    <DoubleAnimation Storyboard.TargetName="PopupTranslateTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="4" To="0" Duration="0:0:0.167">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="PopupHideStoryboard">
                    <DoubleAnimation Storyboard.TargetName="PopupTranslateTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="-2" Duration="0:0:0.083">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseIn"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

                <helpers:QuickPanelBoolToVisibilityConverter x:Key="BoolToVis"/>
                <helpers:QuickPanelInverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Outer frame border overlay -->
        <Border x:Name="PopupBorderOverlay" IsHitTestVisible="False" Canvas.ZIndex="10"/>

        <!-- Content Area -->
        <Grid Margin="16,14,16,14" RowSpacing="10">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PopupTranslateTransform"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title / Window Header -->
                <RowDefinition Height="*"/>    <!-- Active View Host -->
                <RowDefinition Height="Auto"/> <!-- Toast / Status Message -->
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <toolkit:Segmented
                    x:Name="MainTabSegmented"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    SelectedIndex="0"
                    SelectionChanged="MainTabSegmented_SelectionChanged">
                    <toolkit:SegmentedItem x:Name="ClipboardTabItem" Tag="Clipboard" MinWidth="0" MinHeight="32" Padding="8,0" AutomationProperties.Name="剪贴板">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Width="18" Height="18" Source="/Assets/WidgetTitleIcons/quick-panel.svg" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="剪贴板" VerticalAlignment="Center"/>
                        </StackPanel>
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem x:Name="TodoTabItem" Tag="Todo" MinWidth="0" MinHeight="32" Padding="8,0" AutomationProperties.Name="待办">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Width="18" Height="18" Source="/Assets/WidgetTitleIcons/todo.svg" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="待办" VerticalAlignment="Center"/>
                        </StackPanel>
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem x:Name="NotesTabItem" Tag="Notes" MinWidth="0" MinHeight="32" Padding="8,0" AutomationProperties.Name="便签">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Width="18" Height="18" Source="/Assets/WidgetTitleIcons/quick-capture.svg" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="便签" VerticalAlignment="Center"/>
                        </StackPanel>
                    </toolkit:SegmentedItem>
                </toolkit:Segmented>

                <!-- Only the blank space between tabs and actions starts a window drag. -->
                <Border x:Name="HeaderDragRegion" Grid.Column="1" MinWidth="48" Background="Transparent"
                        PointerPressed="Header_PointerPressed"
                        PointerMoved="Header_PointerMoved"
                        PointerReleased="Header_PointerReleased"
                        PointerCaptureLost="Header_PointerCaptureLost"/>

                <!-- Header Actions: Pin, Settings, Close (excluded from the
                     native caption drag region) -->
                <StackPanel x:Name="HeaderActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="PinButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        IsChecked="{Binding IsPinned, Mode=TwoWay}"
                        Click="PinButton_Click"
                        svc:Localized.AutomationNameKey="Notes.WindowOnTop" svc:Localized.ToolTipKey="Notes.WindowOnTop">
                        <FontIcon Glyph="&#xE718;" FontSize="14"/>
                    </ToggleButton>
                    <Button
                        x:Name="SettingsButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- View Presenter: the Todo tab hosts the SAME TodoWidgetContent
                 component used by the desktop widget (one todo UI codebase;
                 both instances stay in sync through TodoRepository). -->
            <Grid Grid.Row="1">
                <controls:QuickPanelClipboardView x:Name="ClipboardView" Visibility="Visible"/>
                <ContentPresenter x:Name="TodoViewHost" Visibility="Collapsed"/>
                <controls:QuickPanelNotesView x:Name="NotesView" Visibility="Collapsed"/>
            </Grid>

            <!-- Toast / Feedback Banner -->
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="2"
                IsOpen="False"
                Severity="Informational"
                IsClosable="True"/>
        </Grid>

        <!-- Manual resize grips: the WinUI pointer input stack bypasses the
             classic WM_NCHITTEST routing for pixels covered by the XAML
             bridge child, so a borderless panel cannot get native edge
             resize; these grips (same pattern as SearchPopupWindow) sit in
             the 16px content margin and resize via AppWindow directly. -->
        <Grid x:Name="ResizeGrid" Canvas.ZIndex="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="7"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="7"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="TopLeft" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="Top" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="TopRight" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="Left" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="Right" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="BottomLeft" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="Bottom" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
            <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="BottomRight" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="ResizeInteraction_PointerMoved" PointerReleased="ResizeInteraction_PointerReleased" PointerCaptureLost="ResizeInteraction_PointerCaptureLost"/>
        </Grid>
    </Grid>
</Window>
