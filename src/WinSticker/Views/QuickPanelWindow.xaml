<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinSticker.Views.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinSticker.Controls"
    xmlns:helpers="using:WinSticker.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          PreviewKeyDown="RootGrid_PreviewKeyDown"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PopupTranslateTransform"/>
        </Grid.RenderTransform>

        <Grid.Resources>
            <Storyboard x:Name="PopupShowStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupTranslateTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="4" To="0" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="PopupHideStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupTranslateTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="0" To="-2" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <helpers:QuickPanelBoolToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:QuickPanelInverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        </Grid.Resources>

        <!-- Outer frame border overlay -->
        <Border x:Name="PopupBorderOverlay" IsHitTestVisible="False" Canvas.ZIndex="10"/>

        <!-- Content Area -->
        <Grid Margin="16,14,16,14" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title / Window Header -->
                <RowDefinition Height="Auto"/> <!-- Main Navigation Tabs (剪贴板, 待办, 便签) -->
                <RowDefinition Height="*"/>    <!-- Active View Host -->
                <RowDefinition Height="Auto"/> <!-- Toast / Status Message -->
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Grid Grid.Row="0" Background="Transparent" PointerPressed="Header_PointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE762;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="快捷面板" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Header Actions: Pin, Settings, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="PinButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        IsChecked="{Binding IsPinned, Mode=TwoWay}"
                        Click="PinButton_Click"
                        ToolTipService.ToolTip="固定窗口">
                        <FontIcon Glyph="&#xE718;" FontSize="14"/>
                    </ToggleButton>
                    <Button
                        x:Name="SettingsButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Tab Bar -->
            <toolkit:Segmented
                x:Name="MainTabSegmented"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="MainTabSegmented_SelectionChanged">
                <toolkit:SegmentedItem Content="剪贴板" Tag="Clipboard"/>
                <toolkit:SegmentedItem Content="待办" Tag="Todo"/>
                <toolkit:SegmentedItem Content="便签" Tag="Notes"/>
            </toolkit:Segmented>

            <!-- View Presenter -->
            <Grid Grid.Row="2">
                <controls:QuickPanelClipboardView x:Name="ClipboardView" Visibility="Visible"/>
                <controls:QuickPanelTodoView x:Name="TodoView" Visibility="Collapsed"/>
                <controls:QuickPanelNotesView x:Name="NotesView" Visibility="Collapsed"/>
            </Grid>

            <!-- Toast / Feedback Banner -->
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="3"
                IsOpen="False"
                Severity="Informational"
                IsClosable="True"/>
        </Grid>
    </Grid>
</Window>
