<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.QuickPanelClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:DeskBox.Helpers"
    xmlns:models="using:DeskBox.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:QuickPanelBoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:QuickPanelInverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <helpers:QuickPanelCountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:QuickPanelZeroCountToVisibilityConverter x:Key="ZeroCountToVis"/>
        <helpers:QuickPanelClipboardDisplayTextConverter x:Key="ClipboardDisplayText"/>
        <helpers:QuickPanelClipboardTypeBadgeConverter x:Key="ClipboardTypeBadge"/>
        <helpers:QuickPanelDateTimeConverter x:Key="DateTimeFormat"/>
        <helpers:QuickPanelStarGlyphConverter x:Key="StarGlyph"/>
        <helpers:QuickPanelStarForegroundConverter x:Key="StarForeground"/>
        <helpers:QuickPanelItemTypeGlyphConverter x:Key="ItemTypeGlyph"/>
        <helpers:QuickPanelItemIsImageConverter x:Key="ItemIsImage"/>
        <helpers:QuickPanelItemIsNotImageConverter x:Key="ItemIsNotImage"/>
        <helpers:QuickPanelImageSourceConverter x:Key="ImageSourceConverter"/>

        <Style x:Key="ClipboardItemActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Category Filter Bar -->
        <toolkit:Segmented
            x:Name="FilterSegmented"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            SelectionChanged="FilterSegmented_SelectionChanged"
            SelectedIndex="0">
            <toolkit:SegmentedItem Content="全部" Tag="All"/>
            <toolkit:SegmentedItem Content="文本" Tag="Text"/>
            <toolkit:SegmentedItem Content="图片" Tag="Image"/>
            <toolkit:SegmentedItem Content="链接" Tag="Link"/>
            <toolkit:SegmentedItem Content="收藏" Tag="Favorites"/>
        </toolkit:Segmented>

        <!-- Search Box & Count Bar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="搜索剪贴板历史..."
                Text="{Binding ClipboardSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                </TextBox.Resources>
            </TextBox>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding TotalCountText}"/>
        </Grid>

        <!-- Clipboard History List -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="HistoryListView"
                ItemsSource="{Binding FilteredClipboardItems}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="HistoryListView_ItemClick"
                DoubleTapped="HistoryListView_DoubleTapped"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QuickCaptureItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            PointerEntered="ItemRoot_PointerEntered"
                            PointerExited="ItemRoot_PointerExited">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="复制" Click="FlyoutCopy_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="粘贴到目标窗口" Click="FlyoutPaste_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="收藏 / 取消收藏" Click="FlyoutFavorite_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE735;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="删除" Click="FlyoutDelete_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Type Icon or Image Thumbnail -->
                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{Binding Converter={StaticResource ItemTypeGlyph}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Converter={StaticResource ItemIsNotImage}}"/>
                                        <Image
                                            Source="{Binding Converter={StaticResource ImageSourceConverter}}"
                                            Stretch="UniformToFill"
                                            Visibility="{Binding Converter={StaticResource ItemIsImage}}"/>
                                    </Grid>
                                </Border>

                                <!-- Text & Metadata -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        helpers:WidgetTextShadow.Cast="False"
                                        Text="{Binding Converter={StaticResource ClipboardDisplayText}}"
                                        FontSize="13"
                                        MaxLines="2"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            helpers:WidgetTextShadow.Cast="False"
                                            Text="{Binding CreatedAt, Converter={StaticResource DateTimeFormat}}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Padding="4,1"
                                            CornerRadius="3">
                                            <TextBlock
                                                helpers:WidgetTextShadow.Cast="False"
                                                Text="{Binding Converter={StaticResource ClipboardTypeBadge}}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Hover Action Buttons -->
                                <StackPanel
                                    x:Name="ActionButtonsPanel"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <Button
                                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                                        ToolTipService.ToolTip="收藏"
                                        Click="FavoriteButton_Click">
                                        <FontIcon
                                            FontSize="13"
                                            Glyph="{Binding IsPinned, Converter={StaticResource StarGlyph}}"
                                            Foreground="{Binding IsPinned, Converter={StaticResource StarForeground}}"/>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                                        ToolTipService.ToolTip="复制"
                                        Click="CopyButton_Click">
                                        <FontIcon FontSize="13" Glyph="&#xE8C8;"/>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                                        ToolTipService.ToolTip="删除"
                                        Click="DeleteButton_Click">
                                        <FontIcon FontSize="13" Glyph="&#xE74D;"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding FilteredClipboardItems.Count, Converter={StaticResource ZeroCountToVis}}">
                <FontIcon FontSize="36" Glyph="&#xE8C8;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock
                    Text="暂无剪贴板历史"
                    FontSize="14"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    Text="复制文本、图片或链接后将自动记录在此"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
